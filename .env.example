# Server
PORT=3000
# Only this computer can connect by default. Changing this exposes your cookies and keys.
HOST=127.0.0.1
NODE_ENV=development

# Database
DB_PATH=./data/geo.db

# SerpAPI - get key at https://serpapi.com/
SERPAPI_KEY=

# Optional OpenAI key for AI-powered categorization and recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Playwright (for AI engine scraping)
# Browsers will be auto-installed on first run via: npx playwright install chromium
HEADLESS_BROWSER=true
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36

# Session cookies for AI engines that require login.
# Capture these from your browser DevTools after logging in.
# Format: JSON string with name:value pairs.
CHATGPT_SESSION=
GEMINI_SESSION=
CLAUDE_SESSION=
GROK_SESSION=

# Scheduler - cron expression for automatic tracking runs (default: every day at 6am)
TRACK_CRON=0 6 * * *

# Tracking limits
MAX_PROMPTS_PER_RUN=200
TRACKING_TIMEOUT_MS=120000
